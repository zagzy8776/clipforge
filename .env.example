# ClipForge Environment Configuration
# Copy to .env and fill in values

# ── Database ──
DATABASE_URL=postgresql://clipforge:clipforge_dev@localhost:5432/clipforge

# ── Redis (queue backend) ──
REDIS_URL=redis://localhost:6379

# ── Object Storage (S3-compatible) ──
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=clipforge
S3_ACCESS_KEY=clipforge
S3_SECRET_KEY=clipforge_dev
S3_REGION=us-east-1

# ── ClipForge API ──
CLIPFORGE_API_SECRET=change-me-in-production
CLIPFORGE_PROVIDER=heuristic
# CLIPFORGE_PROVIDER=openai

# ── Optional: OpenAI (for LLM-powered intelligence) ──
# OPENAI_API_KEY=sk-...

# ── Worker ──
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000

# ── Web ──
PORT=3000
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
